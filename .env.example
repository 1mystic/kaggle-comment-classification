# Optional. When set, app/rag.py generates policy explanations via the Anthropic
# API (claude-opus-5). When unset, explanations fall back to a deterministic
# template built from the retrieved policy clause + detected lexicon signals —
# the app works correctly either way, with zero secrets required for the demo.
ANTHROPIC_API_KEY=

# Optional. Overrides where app/audit.py stores its SQLite file. Defaults to
# app/audit.db. On Render's free tier this resets on redeploy — see HANDOFF.md.
AUDIT_DB_PATH=
